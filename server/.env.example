# Render / Server environment variables
NODE_ENV=development
PORT=4000

# CORS settings
ALLOW_ANY_ORIGIN=true
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Database configuration
MONGO_URI=mongodb://127.0.0.1:27017/sharepulse

# App limits & TTLs
MAX_FILE_BYTES=104857600
OTP_TTL_MINUTES=10
CLEANUP_INTERVAL_MS=30000

# Rate limits
REQUEST_WINDOW_MS=900000
REQUEST_MAX=400
OTP_ACTION_MAX=50
SOCKET_BURST_PER_SEC=20

# Optional TURN server for WebRTC production setups
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
